# Copie para .env e preencha. O .env é git-ignorado.

# ---- Servidor local ----
PORT=4400
NODE_ENV=development
SESSION_SECRET=

# ---- Banco MySQL (Hostinger) ----
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Banco local (fonte da verdade offline) ----
SQLITE_PATH=./data/vitrine.db

# ---- Claude Agent SDK ----
ANTHROPIC_API_KEY=

# ---- Domínio público ----
PUBLIC_URL=

# ---- Deploy SSH ----
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_REMOTE_PATH=
SSH_KEY_PATH=
