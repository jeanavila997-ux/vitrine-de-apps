# Copie para .env e preencha. O .env é git-ignorado.

# ---- Servidor local ----
PORT=4400
NODE_ENV=development
SESSION_SECRET=

# ---- Banco MySQL (Hostinger) ----
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Banco local (fonte da verdade offline) ----
SQLITE_PATH=./data/vitrine.db

# ---- Claude Agent SDK ----
ANTHROPIC_API_KEY=

# ---- Ollama ----
# Com API key a URL padrao e https://ollama.com (sem /api no final).
# Sem API key usa http://127.0.0.1:11434
OLLAMA_API_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
OLLAMA_ENABLED=true

# ---- Domínio público ----
PUBLIC_URL=

# ---- Deploy SSH ----
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_REMOTE_PATH=
SSH_KEY_PATH=
